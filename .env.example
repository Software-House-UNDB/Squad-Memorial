# Copie para .env e ajuste os valores
HTTP_PORT=8080

# Django
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,memorial.local,memorial-undb.vercel.app,memorial-api.seudominio.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://memorial.local:8080,https://memorial-undb.vercel.app,https://memorial-api.seudominio.com
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
# Proxies na frente do Django (para o limite de check-in ler o IP certo): nginx = 1; túnel + nginx = 2
DJANGO_NUM_PROXIES=1
# Limite de check-ins por IP (formato do Django REST framework)
CHECKIN_LIMITE_MINUTO=5/min
CHECKIN_LIMITE_HORA=30/hour

# Superusuário criado automaticamente na primeira subida (opcional)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@memorial.local
DJANGO_SUPERUSER_PASSWORD=troque-esta-senha

# Aviso por e-mail aos administradores quando há foto ou cadastro para aprovar (opcional).
# Vazio = sem e-mail; as pendências aparecem no painel /administracao/ do mesmo jeito.
# Quem recebe: superusuários e o grupo Administrativo, no e-mail do usuário.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# 587 = STARTTLS (EMAIL_USE_TLS=1); 465 = SSL direto (EMAIL_USE_SSL=1 e EMAIL_USE_TLS=0)
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=memorial@seudominio.com
# Teste: no painel /administracao/ (botão "Enviar e-mail de teste para mim") ou
#   docker compose exec backend python manage.py testar_email voce@seudominio.com

# PostgreSQL
POSTGRES_DB=memorial
POSTGRES_USER=memorial
POSTGRES_PASSWORD=troque-esta-senha

