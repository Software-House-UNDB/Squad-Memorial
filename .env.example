# Copie para .env e ajuste os valores
HTTP_PORT=8080

# Django
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,memorial.undb.local,memorial-undb.vercel.app,memorial-api.seudominio.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://memorial.undb.local:8080,https://memorial-undb.vercel.app,https://memorial-api.seudominio.com
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Superusuário criado automaticamente na primeira subida (opcional)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@undb.edu.br
DJANGO_SUPERUSER_PASSWORD=troque-esta-senha

# PostgreSQL
POSTGRES_DB=memorial
POSTGRES_USER=memorial
POSTGRES_PASSWORD=troque-esta-senha

