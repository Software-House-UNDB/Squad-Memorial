{
  "name": "memorial-dom-bosco",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Memorial Dom Bosco Maria Izabel Rodrigues · totens dos 6 espaços e check-in pelo celular (React + Vite + PWA), alimentados pela API Django",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host --port 4173",
    "typecheck": "tsc -b --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "node testes/e2e.mjs",
    "lint": "biome lint .",
    "lint:arquitetura": "depcruise src --config .dependency-cruiser.cjs",
    "lint:mortos": "knip",
    "test:coverage": "vitest run --coverage",
    "test:mutacao": "stryker run"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@sentry/react": "^8.55.2",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/vitest-runner": "^8.7.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "~2.1.8",
    "dependency-cruiser": "^16.10.4",
    "knip": "^5.88.1",
    "playwright": "^1.56.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^2.1.8"
  }
}
