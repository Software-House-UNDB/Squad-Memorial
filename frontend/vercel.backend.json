{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/check-in",
      "destination": "/checkin/index.html"
    },
    {
      "source": "/check-in/",
      "destination": "/checkin/index.html"
    },
    {
      "source": "/memorial/api/:path*",
      "destination": "https://SEU-TUNEL.exemplo.com/memorial/api/:path*"
    },
    {
      "source": "/memorial/media/:path*",
      "destination": "https://SEU-TUNEL.exemplo.com/memorial/media/:path*"
    },
    {
      "source": "/memorial/sala/:n",
      "destination": "/index.html"
    },
    {
      "source": "/memorial/:path*",
      "destination": "/:path*"
    }
  ],
  "headers": [
    {
      "source": "/memorial/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/memorial/(sw\\.js|registerSW\\.js|manifest\\.webmanifest|workbox-[^/]+\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/memorial/",
      "permanent": false
    },
    {
      "source": "/checkin",
      "destination": "/check-in/",
      "permanent": true
    }
  ]
}
