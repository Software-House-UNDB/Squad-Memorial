# Produção (docker-compose.prod.yml). Copie para .env no servidor, preencha e proteja:
#   cp .env.prod.example .env && chmod 600 .env
# Nada aqui vai para o git. Gere as chaves e senhas com:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# Não use "$" nos valores: o Docker Compose lê "$abc" como variável e corta a senha (ou escreva "$$").

# ---------------------------------------------------------------- domínio e https
# Nome do servidor (vários: separados por espaço; o primeiro é o do certificado). Na VPN, pode ser o IP
# do servidor (ex.: 10.8.0.10) ou o nome interno que os totens usam.
SERVER_NAME=memorial.seudominio.edu.br
HTTP_PORT=80
HTTPS_PORT=443
# Let's Encrypt só funciona se o servidor responder pela internet na porta 80 (não é o caso só com VPN).
CERTBOT_EMAIL=ti@seudominio.edu.br
# Certificado institucional (opcional). Ponha os arquivos em nginx/certs/ (ou em CERTS_DIR) e aponte aqui.
# Vazio = Let's Encrypt, se emitido; senão um autoassinado gerado em DADOS_DIR/certificado.
CERTS_DIR=./nginx/certs
SSL_CERT=
SSL_KEY=

# ---------------------------------------------------------------- Django
# OBRIGATÓRIO: chave nova e única para a produção (o Django não sobe sem ela)
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=memorial.seudominio.edu.br
DJANGO_CSRF_TRUSTED_ORIGINS=https://memorial.seudominio.edu.br
# Só se outro site chamar a API pelo navegador. Vazio = ninguém.
DJANGO_CORS_ALLOWED_ORIGINS=
# Proxies na frente do Django: nginx sozinho = 1; atrás do proxy reverso da universidade = 2
DJANGO_NUM_PROXIES=1
CHECKIN_LIMITE_MINUTO=5/min
CHECKIN_LIMITE_HORA=30/hour

# gunicorn: workers × threads = pedidos simultâneos. Sugestão: workers = 2 × núcleos + 1
GUNICORN_WORKERS=5
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=600

# ---------------------------------------------------------------- primeiro acesso
# Superusuário criado na primeira subida, se ainda não existir. Depois de entrar e trocar a senha
# pelo admin, apague DJANGO_SUPERUSER_PASSWORD daqui.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# ---------------------------------------------------------------- e-mail (avisos de aprovação)
# Vazio = sem e-mail; as pendências aparecem no painel /administracao/ do mesmo jeito.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# 587 = STARTTLS (EMAIL_USE_TLS=1); 465 = SSL direto (EMAIL_USE_SSL=1 e EMAIL_USE_TLS=0)
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=5
DEFAULT_FROM_EMAIL=memorial@seudominio.edu.br

# ---------------------------------------------------------------- PostgreSQL
POSTGRES_DB=memorial
POSTGRES_USER=memorial
# OBRIGATÓRIO: senha forte
POSTGRES_PASSWORD=

# ---------------------------------------------------------------- pastas do servidor
# Fotos e vídeos ficam em DADOS_DIR/media, o banco em DADOS_DIR/postgres e o certificado autoassinado em
# DADOS_DIR/certificado. Caminho relativo = ao lado do docker-compose.prod.yml. As pastas são criadas sozinhas.
DADOS_DIR=./dados
# Backups (scripts/backup.sh): onde ficam e quantos de cada tipo manter
BACKUP_DIR=./backups
BACKUP_MANTER=14
