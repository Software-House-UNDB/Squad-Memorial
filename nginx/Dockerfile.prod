# nginx de produção (docker-compose.prod.yml): build do frontend embutido, https e certificado.
# Contexto do build: a raiz do repositório.

# ---------- Etapa 1: build do frontend do totem e do check-in (React + Vite) ----------
FROM node:22-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
# Produção nunca usa o modo demonstração; a API é o próprio servidor (mesma origem).
ENV VITE_MODO_DEMO=0 VITE_API_URL=
RUN npm run build

# ---------- Etapa 2: nginx ----------
FROM nginx:1.27-alpine

# openssl: só para o certificado provisório da primeira subida (nginx/prod/15-certificado.envsh)
RUN apk add --no-cache openssl \
    && rm -f /etc/nginx/conf.d/default.conf \
    && mkdir -p /var/www/certbot /var/cache/nginx/envios

COPY nginx/prod/nginx.prod.conf.template /etc/nginx/templates/default.conf.template
COPY nginx/prod/15-certificado.envsh nginx/prod/40-recarregar-certificado.sh /docker-entrypoint.d/
RUN chmod +x /docker-entrypoint.d/15-certificado.envsh /docker-entrypoint.d/40-recarregar-certificado.sh
COPY --from=build /app/dist /usr/share/nginx/html
